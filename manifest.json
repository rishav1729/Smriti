{
  "manifest_version": 3,
  "name": "Smriti — Your Browsing Memory",
  "version": "0.1.0",
  "description": "A local-first knowledge graph built from your open tabs and browsing history. Nothing leaves your machine.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "idle", "offscreen"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smriti"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}